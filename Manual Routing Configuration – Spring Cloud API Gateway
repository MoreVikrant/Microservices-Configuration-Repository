spring.application.name=api-gateway
server.port=8080

# Manual Route Configuration

# Route 1
spring.cloud.gateway.routes[0].id=service-1
spring.cloud.gateway.routes[0].uri=http://localhost:8081
spring.cloud.gateway.routes[0].predicates[0]=Path=/service1/**

# Route 2
spring.cloud.gateway.routes[1].id=service-2
spring.cloud.gateway.routes[1].uri=http://localhost:8082
spring.cloud.gateway.routes[1].predicates[0]=Path=/service2/**

# Route 3
spring.cloud.gateway.routes[2].id=service-3
spring.cloud.gateway.routes[2].uri=http://localhost:8083
spring.cloud.gateway.routes[2].predicates[0]=Path=/service3/**
